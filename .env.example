VITE_API_URL=http://localhost:8080
VITE_ENABLE_MOCKS=true
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: substitui o WhatsApp de ajuda/demonstração da landing.
# WhatsApp recebe mensagem com plano e valor; outros destinos recebem plan, period e intent.
VITE_SUBSCRIPTION_URL=
# Cadastro e assinatura usam VITE_API_URL.
# Chaves Stripe e segredos de webhook pertencem ao backend, nunca a VITE_*.
# Opcional: serviço de busca de endereços compatível com Nominatim (padrão: nominatim.openstreetmap.org).
# O serviço público aceita no máximo 1 requisição por segundo; use instância própria para volume maior.
VITE_GEOCODING_URL=

# O modo de lançamento é o padrão local e em produção. Use false para testar a integração antiga.
VITE_LAUNCH_MODE=true
# Segredos exclusivos do servidor. Nunca use o prefixo VITE_ para estes valores.
PAROQUIAL_ADMIN_EMAIL=
PAROQUIAL_ADMIN_PASSWORD=
PAROQUIAL_SESSION_SECRET=
PAROQUIAL_ADMIN_TENANT=sao-jose
